---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { FAQ_LIST } from '../data/faq';
import { SITE } from '../data/site';

const pageTitle = 'Gsou Cloud 常见问题解答 (FAQ)';
const pageDescription = '汇总 Gsou Cloud 的 10 条核心 FAQ，详细解答套餐周期计算、DNS 查询、中转路径、客户端报错及多设备使用限制。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': FAQ_LIST.map(item => ({
      '@type': 'Question',
      'name': item.question,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': item.answer
      }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': '首页', 'item': `${SITE.domain}/` },
      { '@type': 'ListItem', 'position': 2, 'name': '常见问题', 'item': `${SITE.domain}/faq/` }
    ]
  }
];
---

<BaseLayout title={`${pageTitle} | ${SITE.brandName}`} description={pageDescription} canonicalPath="/faq/" jsonLd={jsonLd}>
  <div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
    <nav class="breadcrumb">
      <a href="/">首页</a> <span class="sep">/</span>
      <span>常见问题</span>
    </nav>

    <header style="margin-bottom: 3.5rem;">
      <div class="section-tag">FREQUENTLY ASKED QUESTIONS</div>
      <h1 class="section-title">Gsou Cloud 常见问题解答 (FAQ)</h1>
      <p class="section-subtitle">
        收录用户最关注的 10 项关于套餐价格、网络技术、流量使用与客户端保养的技术问答。
      </p>
    </header>

    <div class="faq-page-content">
      <FaqSection defaultOpen={true} />

      <div class="faq-footer-box">
        <h3>未找到你关心的解答？</h3>
        <p>您可以参阅完整的<a href="/library/">知识文章档案馆</a>，或者直接跳转至选购控制面板核对实时信息。</p>
        <div style="margin-top: 1.25rem;">
          <a
            href={SITE.affUrl}
            target={SITE.affTarget}
            rel={SITE.affRel}
            class="btn btn-primary"
          >
            前往选购面板
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.faq-footer-box {
  margin-top: 4rem;
  background-color: #FAF9F6;
  border: 1px solid var(--color-border);
  padding: 2.5rem;
  border-radius: 4px;
}

.faq-footer-box h3 {
  font-size: 1.3rem;
  margin-bottom: 0.5rem;
}

.faq-footer-box p {
  font-size: 0.95rem;
  color: var(--color-text-muted);
}

.faq-footer-box a {
  color: var(--color-terracotta);
  text-decoration: underline;
}
</style>
