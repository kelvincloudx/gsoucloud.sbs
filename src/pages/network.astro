---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const pageTitle = 'Gsou Cloud 网络技术与节点传输知识';
const pageDescription = '详细了解 Gsou Cloud 公网隧道中转、IPLC 专线路由、Shadowsocks 与 V2ray 加密传输协议及多区域节点设计。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': '首页', 'item': `${SITE.domain}/` },
      { '@type': 'ListItem', 'position': 2, 'name': '网络知识', 'item': `${SITE.domain}/network/` }
    ]
  }
];
---

<BaseLayout title={`${pageTitle} | ${SITE.brandName}`} description={pageDescription} canonicalPath="/network/" jsonLd={jsonLd}>
  <div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
    <nav class="breadcrumb">
      <a href="/">首页</a> <span class="sep">/</span>
      <span>网络知识</span>
    </nav>

    <header style="margin-bottom: 3.5rem;">
      <div class="section-tag">NETWORK ARCHITECTURE</div>
      <h1 class="section-title">Gsou Cloud 网络技术与节点资料</h1>
      <p class="section-subtitle">
        拆解中转传输架构、加密协议特点及全球多区域节点的选择原则，让技术参数不再晦涩难懂。
      </p>
    </header>

    <div class="tech-sections">
      <!-- Section 1 -->
      <section class="tech-block">
        <div class="block-tag font-mono">01 // MIDDLEMAN ROUTING</div>
        <h2>公网隧道中转与 IPLC 专线路由</h2>
        <p>
          代理传输的核心在于如何将数据快速、稳定地送出公网出口。Gsou Cloud 在网络架构中采用了“入口国内中转 + 出口海外落地”的双重通道：
        </p>
        <div class="two-col-box">
          <div class="sub-box">
            <h4>公网隧道中转通道</h4>
            <p>在广州、上海、北京等核心骨干机房部署中转入口，将用户数据加密封装后通过优化公网路径推送到落地出口。性价比突出，适合日常大部分大流量下载。”</p>
          </div>
          <div class="sub-box">
            <h4>IPLC 内网专线通道</h4>
            <p>租用点对点的国际内网专线（如沪日、粤港专线），数据传输避开公网国际出口拥堵节点。具备极其平稳的延迟与极低的丢包率，是高清视频与即时通信的首选。”</p>
          </div>
        </div>
      </section>

      <!-- Section 2 -->
      <section class="tech-block">
        <div class="block-tag font-mono">02 // PROTOCOLS</div>
        <h2>加密与传输协议 (Shadowsocks / V2ray)</h2>
        <p>
          协议决定了数据在传输过程中的隐秘性与封装效率。客户端支持多种主流协议：
        </p>
        <ul>
          <li><strong>Shadowsocks / ShadowsocksR (SS/SSR)：</strong>经典且轻量的对称加密协议，CPU 占用极低，在移动设备上耗电小；</li>
          <li><strong>V2ray vmess / vless：</strong>具有强大的特征伪装与握手鉴权能力，面对复杂的网络封锁环境表现出极高的连通恢复能力。</li>
        </ul>
      </section>

      <!-- Section 3 -->
      <section class="tech-block">
        <div class="block-tag font-mono">03 // REGIONAL NODES</div>
        <h2>节点覆盖区域与选择原则</h2>
        <p>
          不同地区的节点在地理延迟与访问限制解锁方面各具优势：
        </p>
        <div class="nodes-grid">
          <div class="node-chip">
            <strong>香港节点 (HK)</strong>
            <span>物理距离最近，物理 Ping 延迟低，适合日常极速浏览。</span>
          </div>
          <div class="node-chip">
            <strong>日本节点 (JP)</strong>
            <span>对于游戏与日区服务支持优秀，专线抖动极小。</span>
          </div>
          <div class="node-chip">
            <strong>台湾节点 (TW)</strong>
            <span>高清流媒体体验顺畅，繁体中文服务首选。</span>
          </div>
          <div class="node-chip">
            <strong>新加坡节点 (SG)</strong>
            <span>东南亚节点枢纽，路由覆盖全面且均衡。</span>
          </div>
          <div class="node-chip">
            <strong>美国节点 (US)</strong>
            <span>适合大文件传输、开源代码拉取与美区服务接入。</span>
          </div>
        </div>
      </section>

      <!-- Links to articles -->
      <div class="tech-articles-box">
        <h3>技术延伸阅读</h3>
        <p>如需深入探究网络连接从本地到目标网站的具体运行过程，欢迎参阅：</p>
        <ul>
          <li><a href="/library/route-journey/">《Gsou Cloud网络连接中的路由路径是什么？》</a></li>
          <li><a href="/library/experience-evaluation/">《Gsou Cloud使用体验如何客观判断？》</a></li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.tech-sections {
  display: flex;
  flex-direction: column;
  gap: 3.5rem;
}

.tech-block {
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border);
  padding: 2.5rem;
  border-radius: 4px;
}

.block-tag {
  font-size: 0.8rem;
  color: var(--color-terracotta);
  font-weight: 700;
  margin-bottom: 0.75rem;
}

.tech-block h2 {
  font-size: 1.6rem;
  margin-bottom: 1rem;
}

.tech-block p {
  font-size: 1rem;
  color: var(--color-text-dark);
  line-height: 1.75;
  margin-bottom: 1.25rem;
}

.two-col-box {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.sub-box {
  background-color: var(--color-ivory);
  border: 1px solid var(--color-border);
  padding: 1.5rem;
}

.sub-box h4 {
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
  color: var(--color-graphite);
}

.sub-box p {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  margin-bottom: 0;
}

.nodes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1.5rem;
}

.node-chip {
  background-color: var(--color-ivory);
  border: 1px solid var(--color-border);
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.node-chip strong {
  font-family: var(--font-serif);
  font-size: 1rem;
  color: var(--color-graphite);
}

.node-chip span {
  font-size: 0.825rem;
  color: var(--color-text-muted);
}

.tech-articles-box {
  background-color: #FAF9F6;
  border: 1px solid var(--color-border);
  padding: 2rem;
}

.tech-articles-box h3 {
  font-size: 1.25rem;
  margin-bottom: 0.5rem;
}

.tech-articles-box ul {
  padding-left: 1.25rem;
  margin-top: 0.5rem;
}

.tech-articles-box a {
  color: var(--color-terracotta);
  text-decoration: underline;
}

@media (max-width: 768px) {
  .two-col-box, .nodes-grid {
    grid-template-columns: 1fr;
  }
}
</style>
