---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  jsonLd
} = Astro.props;

// Ensure clean canonical URL with trailing slash handling
const cleanPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = `${SITE.domain}${cleanPath}`;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={SITE.brandName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_CN" />

  <!-- Preconnect and fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Structured Data -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body>
  <!-- Header -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo" title={SITE.brandName}>
        <span>{SITE.brandEn}</span>
        <span class="brand-badge">ARCHIVE</span>
      </a>

      <nav class="nav-desktop">
        {SITE.nav.map(item => (
          <a
            href={item.href}
            class={`nav-link ${currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="header-cta">
        <a
          href={SITE.affUrl}
          target={SITE.affTarget}
          rel={SITE.affRel}
          class="btn btn-primary"
        >
          立即注册
        </a>
        <button id="mobileMenuBtn" class="mobile-toggle" aria-label="切换菜单">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobileNavDrawer" class="mobile-nav">
      {SITE.nav.map(item => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
      <a
        href={SITE.affUrl}
        target={SITE.affTarget}
        rel={SITE.affRel}
        class="btn btn-primary"
        style="margin-top: 0.5rem;"
      >
        立即注册
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main style="flex: 1;">
    <slot />
  </main>

  <!-- Single Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <h3>{SITE.brandName}</h3>
          <p>
            Gsou Cloud 单品牌网络订阅服务指南档案馆。致力于提供透明的套餐说明、网络路由解析、客户端配置教程及常见故障诊断。
          </p>
          <a
            href={SITE.affUrl}
            target={SITE.affTarget}
            rel={SITE.affRel}
            class="btn btn-primary"
            style="display: inline-flex;"
          >
            开通服务
          </a>
        </div>

        <div>
          <div class="footer-links-title">核心导航</div>
          <ul class="footer-links-list">
            <li><a href="/">网站首页</a></li>
            <li><a href="/plans/">订阅套餐矩阵</a></li>
            <li><a href="/start/">新手使用入门</a></li>
            <li><a href="/clients/">客户端知识</a></li>
            <li><a href="/network/">技术与节点知识</a></li>
          </ul>
        </div>

        <div>
          <div class="footer-links-title">知识文章</div>
          <ul class="footer-links-list">
            <li><a href="/library/before-payment/">付款前注意事项</a></li>
            <li><a href="/library/route-journey/">网络路由路径</a></li>
            <li><a href="/library/data-behavior/">流量行为分析</a></li>
            <li><a href="/library/maintenance-calendar/">客户端维护日历</a></li>
            <li><a href="/library/error-messages/">错误信息解答</a></li>
          </ul>
        </div>

        <div>
          <div class="footer-links-title">技术与帮助</div>
          <ul class="footer-links-list">
            <li><a href="/library/device-limits/">设备数量限制解析</a></li>
            <li><a href="/library/experience-evaluation/">体验评估方法</a></li>
            <li><a href="/library/">所有文章目录</a></li>
            <li><a href="/faq/">常见问题 FAQ</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>
          &copy; {new Date().getFullYear()} {SITE.brandEn} Archives. All rights reserved. | Domain: {SITE.domain}
        </div>
      </div>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('mobileMenuBtn');
    const menuDrawer = document.getElementById('mobileNavDrawer');
    if (menuBtn && menuDrawer) {
      menuBtn.addEventListener('click', () => {
        menuDrawer.classList.toggle('open');
      });
    }
  </script>
</body>
</html>
