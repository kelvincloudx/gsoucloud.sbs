---
import { FAQ_LIST } from '../data/faq';

interface Props {
  defaultOpen?: boolean;
}

const { defaultOpen = true } = Astro.props;
---

<section class="faq-section">
  <div class="faq-container">
    {FAQ_LIST.map((item, idx) => (
      <details class="faq-item" open={defaultOpen}>
        <summary class="faq-question">
          <span class="faq-num font-mono">Q{idx + 1}</span>
          <span class="faq-q-text">{item.question}</span>
          <span class="faq-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
.faq-container {
  display: flex;
  flex-direction: column;
  border-top: 2px solid var(--color-graphite);
}

.faq-item {
  border-bottom: 1px solid var(--color-border);
  transition: var(--transition);
}

.faq-question {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.5rem 0;
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--color-graphite);
  cursor: pointer;
  list-style: none;
}

.faq-question::-webkit-details-marker {
  display: none;
}

.faq-num {
  font-size: 0.9rem;
  color: var(--color-terracotta);
  font-weight: 600;
  width: 2.5rem;
  flex-shrink: 0;
}

.faq-q-text {
  flex-grow: 1;
  line-height: 1.4;
}

.faq-icon {
  color: var(--color-text-muted);
  transition: transform 0.25s ease;
  flex-shrink: 0;
}

.faq-item[open] .faq-icon {
  transform: rotate(180deg);
  color: var(--color-terracotta);
}

.faq-answer {
  padding: 0 0 1.5rem 3.75rem;
  font-size: 1rem;
  color: var(--color-text-dark);
  line-height: 1.75;
}

@media (max-width: 640px) {
  .faq-question {
    font-size: 1rem;
    gap: 0.75rem;
  }
  .faq-num {
    width: 2rem;
  }
  .faq-answer {
    padding: 0 0 1.25rem 2.75rem;
    font-size: 0.925rem;
  }
}
</style>
